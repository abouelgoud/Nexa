# Copy to .env and adjust. Never commit real secrets.

# --- Platform ---------------------------------------------------------------
ENVIRONMENT=development
POSTGRES_USER=nexa
POSTGRES_PASSWORD=nexa
POSTGRES_DB=nexa
# Password of the read/write user of the bundled demo clinic database
CLINIC_DB_PASSWORD=clinic_agent
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# Fernet key for encrypting integration credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=Wm9vX2RldmVsb3BtZW50X2tleV9kb19ub3RfdXNlXzE=
WEB_ORIGIN=http://localhost:3000
# Empty = the browser reaches the API through the web app (/api), which works on any host.
PUBLIC_API_URL=
# Allow integrations to reach private networks (needed for the bundled demo clinic DB). false in production.
ALLOW_PRIVATE_NETWORK_INTEGRATIONS=true

# --- AI: LOCAL_AI=true uses vLLM/Qwen, Whisper and Piper ----------------------
LOCAL_AI=true
# local | openai_compatible | cloud | custom   (all speak the OpenAI-compatible protocol today)
LLM_PROVIDER=local
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=not-needed
# CPU alternative (docker compose --profile cpu-llm up, then: docker compose exec ollama ollama pull qwen3:8b)
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen3:8b
HF_TOKEN=

STT_PROVIDER=whisper
STT_BASE_URL=http://stt:8001/v1
# large-v3 on a GPU (WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16); small/int8 is a usable CPU default
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

TTS_PROVIDER=piper
TTS_BASE_URL=http://tts:8002
PIPER_VOICES=ar_JO-kareem-medium,en_US-amy-medium

# hashing (offline, lexical) | openai_compatible (e.g. a TEI/vLLM server with BAAI/bge-m3)
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=http://embeddings:8003/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- Telephony / WebRTC -------------------------------------------------------
SIP_PROVIDER=livekit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_devsecret
# What browsers use to reach LiveKit
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- Observability --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
