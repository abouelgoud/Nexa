# Copy to .env and adjust. Never commit real secrets.

# --- Platform ---------------------------------------------------------------
ENVIRONMENT=development
POSTGRES_USER=nexa
POSTGRES_PASSWORD=nexa
POSTGRES_DB=nexa
# Password of the read/write user of the bundled demo clinic database
CLINIC_DB_PASSWORD=clinic_agent
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# Fernet key for encrypting integration credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=Wm9vX2RldmVsb3BtZW50X2tleV9kb19ub3RfdXNlXzE=
WEB_ORIGIN=http://localhost:3000
# Empty = the browser reaches the API through the web app (/api), which works on any host.
PUBLIC_API_URL=
# Allow integrations to reach private networks (needed for the bundled demo clinic DB). false in production.
ALLOW_PRIVATE_NETWORK_INTEGRATIONS=true

# --- AI: LOCAL_AI=true uses a local LLM, Whisper and Piper -------------------
LOCAL_AI=true
# local | openai_compatible | cloud | custom   (all speak the OpenAI-compatible protocol today)
LLM_PROVIDER=local
# Default: the `llm` service (llama.cpp + Qwen2.5 3B on the CPU, ~2 GB), started by `docker compose up`.
LLM_BASE_URL=http://llm:8080/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=not-needed
# Faster on a Mac: run the LLM natively on the Apple GPU (`ollama serve`, `ollama pull qwen2.5:3b`) and use:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# NVIDIA GPU (docker compose --profile gpu up): LLM_BASE_URL=http://llm-gpu:8000/v1  LLM_MODEL=Qwen/Qwen3-8B
# Memory caps: LLM_MEMORY=3g, STT_MEMORY=2g (3g for WHISPER_MODEL=large-v3-turbo)
HF_TOKEN=

STT_PROVIDER=whisper
STT_BASE_URL=http://stt:8001/v1
# Accuracy: large-v3 (best for Arabic, use a GPU: WHISPER_DEVICE=cuda WHISPER_COMPUTE_TYPE=float16)
# > large-v3-turbo (good, faster) > small (fast, noticeably less accurate). See docs/voice-quality.md
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

TTS_PROVIDER=piper
TTS_BASE_URL=http://tts:8002
PIPER_VOICES=ar_JO-kareem-medium,en_US-amy-medium

# --- Natural voices & high-accuracy recognition (choose per agent in Agent > Voice) ----------------
# Self-hosted natural voices with cloning: docker compose --profile neural up (NVIDIA GPU)
# On a Mac (no NVIDIA GPU): run scripts/voice-mac.sh and use http://host.docker.internal:8004 instead.
NEURAL_TTS_BASE_URL=http://tts-neural:8002
# ElevenLabs: most natural Arabic/English voices + Scribe recognition. Get a key at elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# Azure Speech: native voices per Arabic dialect (Saudi, Egyptian, Gulf, Levantine, Maghrebi...)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# Speech recognition engine: whisper (self-hosted) | elevenlabs | azure

# hashing (offline, lexical) | openai_compatible (e.g. a TEI/vLLM server with BAAI/bge-m3)
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=http://embeddings:8003/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- Telephony / WebRTC -------------------------------------------------------
SIP_PROVIDER=livekit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_devsecret
# What browsers use to reach LiveKit
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- Observability --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
