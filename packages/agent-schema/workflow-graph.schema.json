{
  "$defs": {
    "WorkflowEdgeDef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_\\-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "handle": {
          "default": "default",
          "title": "Handle",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "WorkflowEdgeDef",
      "type": "object"
    },
    "WorkflowNodeDef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_\\-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "start",
            "say",
            "ask",
            "collect",
            "condition",
            "tool",
            "knowledge_search",
            "transfer",
            "wait",
            "confirm",
            "end"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "position": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Position",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "WorkflowNodeDef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/WorkflowNodeDef"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/WorkflowEdgeDef"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "nodes"
  ],
  "title": "WorkflowGraph",
  "type": "object"
}
